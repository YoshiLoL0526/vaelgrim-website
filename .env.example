# Copy this file to `.env` and fill in the real values before `npm run build`.
# They are public values baked into the build (no secrets here).

# Where the "Play now" buttons point: the playable game.
VITE_GAME_URL=https://play.vaelgrim.com
# Absolute URL of this website, used for the social preview image (og:image).
VITE_SITE_URL=https://vaelgrim.com
